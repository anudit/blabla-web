{
  "name": "blabla",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx portless blabla bun --hot index.ts",
    "build": "bun run build.ts",
    "serve": "bunx live-server ./dist",
    "start": "NODE_ENV=production bun index.ts",
    "bundlestats": "bun run build && bunx esbuild-visualizer --metadata ./dist/meta.json --filename ./dist/stats.html --open",
    "outdated": "bunx npm-check-updates --interactive"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "lucide-preact": "^1.75.0",
    "paddleocr-webgpu": "^1.4.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@webgpu/types": "^0.1.74"
  }
}
